#include<iostream>
using namespace std; //표준 라이브러리.. 뒤에 코드에 직접 명시를 피하기 위해서 선언

int main(){
    int N,X ; //N이랑 X 입력값 받을 변수 지정
    cin >> N >> X; //cin 사용해봄
    
    for (int i = 0; i < N; i ++){
        int low;
        cin >> low;
        if (low < X) {
            cout << low <<" "; // 공백을 구분하면서 순서대로 출력하는것..
        }
    }
return 0;    
} //메인함수정의
